# Browser-facing API base. Leave blank when Next.js proxies /api to FastAPI locally.
NEXT_PUBLIC_API_BASE_URL=

# Internal backend URL used by the Next.js /api rewrite.
API_INTERNAL_URL=http://127.0.0.1:8000

# Set to 1 only when you deliberately want the bundled synthetic UI dataset.
NEXT_PUBLIC_FIXTURE_DATA=0
